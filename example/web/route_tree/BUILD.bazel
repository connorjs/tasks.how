load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:@tanstack/router-cli/package_json.bzl", tsr_bin = "bin")

write_source_files(
    name = "codegen",
    files = {
        "route_tree.gen.ts": ".route_tree.gen.ts",
    },
)

ts_project(
    name = "main",
    srcs = ["route_tree.gen.ts"],
    emit_declaration_only = True,
    tsconfig = "//:tsconfig",
    visibility = ["//example/web/router:__pkg__"],
    deps = ["//example/web/routes:main"],
)

tsr_bin.tsr(
    name = "tsr",
    srcs = [
        "tsr.config.json",
        "//example/web/routes:main",
    ],
    outs = [".route_tree.gen.ts"],
    args = ["generate"],
    chdir = package_name(),
)
