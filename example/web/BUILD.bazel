load("@aspect_rules_js//js:defs.bzl", "js_run_devserver")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")
load("//:ts_library.bzl", "ts_library")

ts_library(
    name = "main",
    srcs = [
        "vite.config.mts",
    ],
    declaration = True,
    emit_declaration_only = True,
    tsconfig = "//:tsconfig",
    deps = [
        "//:node_modules/@tanstack/react-start",
        "//:node_modules/@vitejs/plugin-react",
        "//:node_modules/vite",
    ],
)

vite_srcs = [
    ":main",
    "//:tsconfig",
    "//:node_modules/react-dom",
    "//example/web/routes:main",
]

vite_bin.vite(
    name = "vite_build",
    srcs = vite_srcs,
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

vite_bin.vite_binary(
    name = "vite",
)

js_run_devserver(
    name = "web",
    args = ["dev"],
    chdir = package_name(),
    data = vite_srcs,
    tool = ":vite",
)
