module(
    name = "tasks_how",
)

# Bazel 9 uses Bzlmod as the dependency entry point. WORKSPACE.bazel stays as
# a lightweight compatibility marker for tools that still look for one.
bazel_dep(name = "aspect_rules_lint", version = "2.5.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.0")
bazel_dep(name = "aspect_rules_js", version = "1.40.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_multitool", version = "0.11.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_typescript", version = "0.1.0")
git_override(
    module_name = "rules_typescript",
    commit = "5b96059c4c361cf9ca2e1bc3ee908ae5e8160e02",
    remote = "https://github.com/mikn/rules_typescript.git",
)

register_toolchains("@rules_typescript//ts/toolchain:all")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

npm = use_extension("@rules_typescript//npm:extensions.bzl", "npm")
npm.translate_lock(pnpm_lock = "//:pnpm-lock.yaml")
use_repo(npm, "npm")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.2",
)
use_repo(go_sdk, "go_sdk")

register_toolchains("@go_sdk//:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_go_chi_chi_v5",
)
