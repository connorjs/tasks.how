load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_typescript//npm:defs.bzl", "node_modules")

package(default_visibility = ["//visibility:public"])

node_modules(
    name = "node_modules",
    deps = ["@npm//:oxfmt"],
)

# TODO: AI: Why do we make shell wrappers for everything? This seems wasteful.
#  From AI: We only keep wrappers for npm-bin CLIs that change their working directory into Bazel runfiles. Without the wrapper, workspace-relative formatter invocations break under `format_multirun`.
sh_binary(
    name = "prettier",
    srcs = ["prettier.sh"],
    data = [
        "@npm//:prettier_bin",
    ],
)

sh_binary(
    name = "oxfmt",
    srcs = ["oxfmt.sh"],
    data = [
        ":node_modules",
        "@npm//:oxfmt_bin",
    ],
)
