load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

sh_test(
    name = "buildifier_test",
    srcs = ["buildifier_test.sh"],
    args = [
        "$(rootpath @buildifier_prebuilt//:buildifier)",
    ],
    data = [
        "//:buildifier_srcs",
        "@buildifier_prebuilt//:buildifier",
    ],
    tags = ["lint"],
)

sh_test(
    name = "oxlint_test",
    srcs = ["oxlint_test.sh"],
    args = [
        "$(rootpath @npm//:oxlint_bin)",
        "$(rootpath //:oxlint.config.js)",
    ],
    data = [
        "//:oxlint.config.js",
        "//experiences/board/ui:lint_srcs",
        "@npm//:oxlint_bin",
    ],
    tags = ["lint"],
)

test_suite(
    name = "lint",
    tests = [
        ":buildifier_test",
        ":oxlint_test",
    ],
)
