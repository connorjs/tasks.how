load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# TODO: AI: Why do we need this? We have format and format.check with multirun
#  From AI: `format` and `format.check` are runnable commands, not test targets. Keeping a dedicated Buildifier test means `bazel test //...` and test-tag filters still verify Bazel/Starlark hygiene in CI.
sh_test(
    name = "buildifier_test",
    srcs = ["buildifier_test.sh"],
    args = [
        "$(rootpath @buildifier_prebuilt//:buildifier)",
    ],
    data = [
        "//:starlark_files",
        "@buildifier_prebuilt//:buildifier",
    ],
    tags = ["lint"],
)

sh_test(
    name = "oxlint_test",
    srcs = ["oxlint_test.sh"],
    args = [
        "$(rootpath @npm//:oxlint_bin)",
        "$(rootpath //:oxlint.json)",
    ],
    data = [
        "//:oxlint.json",
        "//experiences/board/ui:lint_srcs",
        "@npm//:oxlint_bin",
    ],
    tags = ["lint"],
)

test_suite(
    name = "lint",
    tests = [
        ":buildifier_test",
        ":oxlint_test",
    ],
)
