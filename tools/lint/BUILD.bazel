load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

sh_test(
    name = "buildifier_test",
    srcs = ["buildifier_test.sh"],
    args = [
        "$(rootpath @buildifier_prebuilt//:buildifier)",
    ],
    data = [
        "//:starlark_files",
        "@buildifier_prebuilt//:buildifier",
    ],
)

sh_test(
    name = "eslint_test",
    srcs = ["eslint_test.sh"],
    args = [
        "$(rootpath @npm//:eslint_bin)",
        "$(rootpath //:eslint.config.mjs)",
    ],
    data = [
        "//:eslint.config.mjs",
        "//:node_modules",
        "//experiences/board/ui/src:lint_srcs",
        "@npm//:eslint_bin",
    ],
)

test_suite(
    name = "lint",
    tests = [
        ":buildifier_test",
        ":eslint_test",
    ],
)
